class Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write("cad-guard: %s\n" % message)
        sys.exit(EXIT_USAGE)


class Finding(Exception):
    def __init__(self, verdict, reason, counters):
        Exception.__init__(self, reason)
        self.verdict = verdict
        self.reason = reason
        self.counters = counters


def count_entities(fh, max_entities):
    carry = b""
    count = 0
    found = False
    while True:
        block = fh.read(CHUNK)
        if not block:
            break
        if not found:
            buf = carry + block
            hit = DATA_SECTION.search(buf)
            if hit is None:
                carry = buf[-32:]
                continue
            found = True
            block = buf[hit.start():]
        count += block.count(b";")
        if count - STRUCTURAL_TERMINATORS > max_entities:
            return found, count - STRUCTURAL_TERMINATORS
    return found, max(count - STRUCTURAL_TERMINATORS, 0)


def find_tokens(mm, token, limit):
    positions = []
    pos = mm.find(token)
    while pos != -1:
        positions.append(pos)
        if len(positions) > limit:
            break
        pos = mm.find(token, pos + len(token))
    return positions


def params(mm, pos, want, budget):
    out = []
    cur = []
    depth = 0
    for m in TOKENS.finditer(mm, pos):
        budget -= 1
        if budget < 0:
            return None
        tok = m.group()
        if depth == 0:
            if tok == b"(":
                depth = 1
            elif tok.strip() or tok.startswith(b"'"):
                return None
            continue
        if tok == b"(":
            depth += 1
            cur.append(tok)
        elif tok == b")":
            depth -= 1
            if depth == 0:
                out.append(b"".join(cur).strip())
                return out
            cur.append(tok)
        elif tok == b"," and depth == 1:
            out.append(b"".join(cur).strip())
            cur = []
            if len(out) >= want:
                return out
        elif tok.startswith(b"/*"):
            continue
        else:
            cur.append(tok)
    return None


def statement_id(mm, pos):
    start = mm.rfind(b";", 0, pos) + 1
    head = STATEMENT_HEAD.match(mm, start)
    if head is None or head.end() > pos:
        return None
    return int(head.group(1))


def identifier_bounds(mm, pos, length):
    start = pos
    while start > 0 and pos - start < IDENTIFIER_LIMIT and mm[start - 1] in IDENTIFIER:
        start -= 1
    end = pos + length
    size = len(mm)
    while end < size and end - pos < IDENTIFIER_LIMIT and mm[end] in IDENTIFIER:
        end += 1
    return start, end


def nauo_edges(mm, positions):
    edges = []
    for pos in positions:
        found = params(mm, pos + len(NAUO_TOKEN), 5, PARAM_BUDGET)
        if found is None or len(found) < 5:
            continue
        relating = ENTITY_REF.match(found[3])
        related = ENTITY_REF.match(found[4])
        if relating and related:
            edges.append((int(relating.group(1)), int(related.group(1))))
    return edges


def mapped_item_edges(mm):
    items = {}
    for pos in find_tokens(mm, MAPPED_TOKEN, 1 << 62):
        if pos > 0 and mm[pos - 1] in IDENTIFIER:
            continue
        if not OPEN_PAREN.match(mm, pos + len(MAPPED_TOKEN)):
            continue
        found = params(mm, pos + len(MAPPED_TOKEN), 2, PARAM_BUDGET)
        if found is None or len(found) < 2:
            continue
        source = ENTITY_REF.match(found[1])
        ident = statement_id(mm, pos)
        if source and ident is not None:
            items[ident] = int(source.group(1))
    if not items:
        return []
    maps = {}
    containers = []
    pos = mm.find(REPRESENTATION_TOKEN)
    while pos != -1:
        start, end = identifier_bounds(mm, pos, len(REPRESENTATION_TOKEN))
        name = mm[start:end]
        if OPEN_PAREN.match(mm, end):
            ident = statement_id(mm, start)
            if name == REPRESENTATION_MAP:
                found = params(mm, end, 2, PARAM_BUDGET)
                if found is not None and len(found) >= 2 and ident is not None:
                    target = ENTITY_REF.match(found[1])
                    if target:
                        maps[ident] = int(target.group(1))
            elif ident is not None:
                found = params(mm, end, 2, ITEMS_BUDGET)
                if found is not None and len(found) >= 2:
                    held = [items[int(r)] for r in ENTITY_REFS.findall(found[1]) if int(r) in items]
                    if held:
                        containers.append((ident, held))
        pos = mm.find(REPRESENTATION_TOKEN, max(end, pos + len(REPRESENTATION_TOKEN)))
    edges = []
    for ident, held in containers:
        for source in held:
            target = maps.get(source)
            if target is not None:
                edges.append((ident, target))
    return edges


def expanded_instances(edges, cap):
    saturated = cap + 1
    children = {}
    indegree = {}
    for parent, child in edges:
        children.setdefault(parent, []).append(child)
        indegree[child] = indegree.get(child, 0) + 1
        indegree.setdefault(parent, 0)
    remaining = dict(indegree)
    paths = {node: (1 if degree == 0 else 0) for node, degree in indegree.items()}
    ready = [node for node, degree in indegree.items() if degree == 0]
    order = sorted(indegree)
    cursor = 0
    done = set()
    total = 0
    while len(done) < len(indegree):
        if not ready:
            while order[cursor] in done:
                cursor += 1
            ready.append(order[cursor])
        node = ready.pop()
        if node in done:
            continue
        done.add(node)
        if indegree[node] > 0:
            total += paths[node]
            if total > cap:
                return saturated
        for child in children.get(node, ()):
            if child in done:
                continue
            paths[child] = min(saturated, paths[child] + paths[node])
            remaining[child] -= 1
            if remaining[child] == 0:
                ready.append(child)
    return total


def scan_step(path, max_entities, max_nauo):
    counters = {}
    with open(path, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            raise Finding("unreadable", "cannot_count", counters)
        found, entities = count_entities(fh, max_entities)
        counters["entities"] = entities
        if not found:
            raise Finding("unreadable", "no_data_section", counters)
        if entities > max_entities:
            raise Finding("too_complex", "entities_over_cap", counters)
        with mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ) as mm:
            positions = find_tokens(mm, NAUO_TOKEN, max_nauo)
            counters["nauo"] = len(positions)
            if len(positions) > max_nauo:
                raise Finding("too_complex", "nauo_over_cap", counters)
            if positions:
                expanded = expanded_instances(nauo_edges(mm, positions), max_nauo)
                counters["expanded"] = expanded
                if expanded > max_nauo:
                    raise Finding("too_complex", "expansion_over_cap", counters)
            if mm.find(MAPPED_TOKEN) != -1:
                expanded = expanded_instances(mapped_item_edges(mm), max_nauo)
                counters["expanded"] = max(expanded, counters.get("expanded", 0))
                if expanded > max_nauo:
                    raise Finding("too_complex", "mapped_item_expansion_over_cap", counters)
    return counters


def scan_iges(path):
    counters = {}
    size = 0
    with open(path, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            raise Finding("unreadable", "cannot_count", counters)
        while True:
            block = fh.read(CHUNK)
            if not block:
                break
            size += len(block) - block.count(b"\n") - block.count(b"\r")
    if size == 0:
        raise Finding("unreadable", "cannot_count", counters)
    counters["records"] = (size + RECORD_WIDTH - 1) // RECORD_WIDTH
    return counters


def code_types():
    size = max(hi for _, hi in REAL_CODES + INT_CODES)
    types = bytearray(size)
    for lo, hi in REAL_CODES:
        types[lo:hi] = bytes([TYPE_REAL]) * (hi - lo)
    for lo, hi in INT_CODES:
        types[lo:hi] = bytes([TYPE_INT]) * (hi - lo)
    lo, hi = COORDINATE_CODES
    types[lo:hi] = bytes([TYPE_COORDINATE]) * (hi - lo)
    return bytes(types)


CODE_TYPES = code_types()


def dxf_lines(fh):
    carry = b""
    while True:
        block = fh.read(LINE_CHUNK)
        if not block:
            break
        data = carry + block if carry else block
        end = len(data) - 1 if data.endswith(b"\r") else len(data)
        cut = max(data.rfind(b"\n", 0, end), data.rfind(b"\r", 0, end)) + 1
        if cut == 0:
            carry = data
            continue
        carry = data[cut:]
        yield data[:cut].splitlines()
    if carry:
        yield carry.splitlines()


def info_tags(fh):
    code = None
    for lines in dxf_lines(fh):
        for line in lines:
            text = line.decode("utf-8", "ignore")
            if code is None:
                code = int(text)
                continue
            tag = (code, text)
            code = None
            if tag == (0, "EOF"):
                yield tag
                return
            if tag[0] != COMMENT_CODE:
                yield tag


def to_encoding(codepage):
    for suffix, encoding in CODEPAGE_ENCODINGS:
        if codepage.endswith(suffix):
            return encoding
    return DEFAULT_ENCODING


def dxf_encoding(fh):
    version = DEFAULT_VERSION
    encoding = DEFAULT_ENCODING
    tags = info_tags(fh)
    try:
        if next(tags) != (0, "SECTION") or next(tags) != (2, "HEADER"):
            return DEFAULT_ENCODING
        tag = None
        undo = None
        found = 0
        while tag != (0, "ENDSEC"):
            if undo is None:
                tag = next(tags)
            else:
                tag, undo = undo, None
            if tag[0] != HEADER_VAR_CODE:
                continue
            name = tag[1]
            code, value = next(tags)
            if code == POINT_X_CODE:
                float(value)
                float(next(tags)[1])
                tag = next(tags)
                if tag[0] == POINT_Z_CODE:
                    float(tag[1])
                else:
                    undo = tag
                value = None
            if name == "$ACADVER":
                version = "(" if value is None else value
            elif name == "$DWGCODEPAGE":
                if value is None:
                    return DEFAULT_ENCODING
                encoding = to_encoding(value)
            elif name not in INFO_COUNTED_VARS:
                continue
            found += 1
            if found >= INFO_VARS_EXPECTED:
                break
    except (StopIteration, ValueError):
        return DEFAULT_ENCODING
    return "utf-8" if version >= UTF8_FROM_VERSION else encoding


def count_value(raw):
    text = raw.strip()
    try:
        return int(text)
    except ValueError:
        pass
    try:
        return int(float(text))
    except (ValueError, OverflowError):
        return COUNT_LIMIT


class BlockGraph:
    def __init__(self, encoding, mult_limit):
        self.encoding = encoding
        self.mult_limit = mult_limit
        self.keys = {}
        self.direct = array("q")
        self.parents = array("q")
        self.children = array("q")
        self.mults = array("q")
        self.unions = []
        self.owned_ids = array("q")
        self.owned_handles = []
        self.records = {}
        self.annotations = []
        self.style_handles = set()
        self.style_names = set()
        self.virtual = []
        self.blocks = 0
        self.last_parent = -1
        self.last_child = -1
        self.root = self.node(MODEL_SPACE)
        self.unions.append((self.root, self.node(PAPER_SPACE)))

    def key(self, raw):
        if raw.isascii():
            return raw.lower()
        key = raw.decode(self.encoding, "surrogateescape").lower()
        return key.encode("ascii") if key.isascii() else key

    def node(self, raw):
        return self.node_of(self.key(raw))

    def node_of(self, key):
        ident = self.keys.get(key)
        if ident is None:
            ident = len(self.direct)
            self.keys[key] = ident
            self.direct.append(0)
        return ident

    def anonymous(self):
        self.direct.append(0)
        return len(self.direct) - 1

    def refer(self, owner, names, mult):
        for raw in names:
            self.edge(owner, self.node(raw), mult)

    def define(self, names, owners):
        self.blocks += 1
        named = [raw for raw in names if raw]
        ident = self.node(named[0]) if named else self.anonymous()
        for raw in named[1:]:
            self.unions.append((ident, self.node(raw)))
        for handle in owners:
            self.owned_ids.append(ident)
            self.owned_handles.append(handle)
        return ident

    def record(self, handles, names):
        for handle in handles:
            self.records.setdefault(handle, []).extend(names)

    def annotate(self, owner, handles, mult):
        self.annotations.append((owner, min(mult, self.mult_limit), tuple(handles)))

    def style(self, handles, names):
        self.style_handles.update(handles)
        self.style_names.update(raw for raw in names if raw)

    def edge(self, parent, child, mult):
        limit = self.mult_limit
        if parent == self.last_parent and child == self.last_child:
            last = len(self.mults) - 1
            mult += self.mults[last]
            self.mults[last] = mult if mult < limit else limit
            return
        self.parents.append(parent)
        self.children.append(child)
        self.mults.append(mult if mult < limit else limit)
        self.last_parent = parent
        self.last_child = child

    def record_names(self, handle):
        return [raw for raw in self.records.get(handle, ()) if raw]

    def resolve_references(self):
        for ident, handle in zip(self.owned_ids, self.owned_handles):
            for raw in self.record_names(handle):
                self.unions.append((ident, self.node(raw)))
        if not self.annotations:
            return
        targets = set(self.style_names)
        for handle in self.style_handles:
            targets.update(self.record_names(handle))
        shared = None
        if targets:
            shared = self.anonymous()
            self.virtual.append(shared)
            for raw in sorted(targets):
                self.edge(shared, self.node(raw), 1)
        for owner, mult, handles in self.annotations:
            if shared is not None:
                self.edge(owner, shared, mult)
            for handle in handles:
                for raw in self.record_names(handle):
                    self.edge(owner, self.node(raw), mult)

def numeric_finding(kind, line, code, counters):
    counters = dict(counters)
    counters["line"] = line
    counters["code"] = code
    return Finding("unreadable", kind, counters)


def dxf_pairs(fh, counters):
    cache = {}
    base = 0
    carry = None
    for lines in dxf_lines(fh):
        if carry is not None:
            lines.insert(0, carry)
            carry = None
        if len(lines) & 1:
            carry = lines.pop()
        if not lines:
            continue
        raw_codes = lines[0::2]
        values = lines[1::2]
        if len(cache) > CODE_CACHE_LIMIT:
            cache = {}
        missing = set(raw_codes).difference(cache)
        for raw in missing:
            text = raw.strip()
            cache[raw] = int(text) if GROUP_CODE.fullmatch(text) else None
        codes = list(map(cache.__getitem__, raw_codes))
        if missing and None in codes:
            bad = codes.index(None)
            for j in range(bad):
                if codes[j] == 0 and values[j] == b"EOF":
                    yield base, codes[:j + 1], values[:j + 1]
                    return
            counters["line"] = base + 2 * bad + 1
            raise Finding("unreadable", "bad_group_code", counters)
        yield base, codes, values
        base += len(lines)


def walk_dxf(fh, graph, max_abs, counters):
    types = CODE_TYPES
    type_count = len(types)
    real = REAL.fullmatch
    isinf = math.isinf
    direct = graph.direct
    key_of = graph.key
    keys = graph.keys
    node_of = graph.node_of
    limit = graph.mult_limit
    add_parent = graph.parents.append
    add_child = graph.children.append
    add_mult = graph.mults.append
    pend_p = pend_c = -1
    pend_m = 0
    pairs = 0
    block_count = 0
    in_entities = in_blocks = in_tables = in_objects = scoped = naming = False
    dimstyle = False
    leader_lines = 0
    kind = None
    capture = 0
    names = []
    owners = []
    handles = []
    cols = rows = 1
    current = -1
    root = graph.root
    final = (-1, [0], [b"EOF"])
    for base, codes, values in itertools.chain(dxf_pairs(fh, counters), (final,)):
        if base >= 0:
            pairs += len(codes)
        for i, c in enumerate(codes):
            if c == 0:
                if kind is not None:
                    if in_blocks and capture == CAPTURE_BLOCK:
                        if owners or len(names) != 1 or not names[0]:
                            current = graph.define(names, owners)
                        else:
                            raw = names[0]
                            key = raw.lower() if raw.isascii() else key_of(raw)
                            current = keys.get(key)
                            if current is None:
                                current = node_of(key)
                            block_count += 1
                    elif in_blocks and kind == b"ENDBLK":
                        current = -1
                    else:
                        owner = root if in_entities else current if in_blocks else -1
                        if owner >= 0:
                            direct[owner] += 1
                            if capture == CAPTURE_INSERT or capture == CAPTURE_REFERENCE:
                                m = (cols if cols > 1 else 1) * (rows if rows > 1 else 1)
                                for raw in names:
                                    key = raw.lower() if raw.isascii() else key_of(raw)
                                    child = keys.get(key)
                                    if child is None:
                                        child = node_of(key)
                                    if owner == pend_p and child == pend_c:
                                        pend_m += m
                                        if pend_m > limit:
                                            pend_m = limit
                                    else:
                                        if pend_p >= 0:
                                            add_parent(pend_p)
                                            add_child(pend_c)
                                            add_mult(pend_m)
                                        pend_p = owner
                                        pend_c = child
                                        pend_m = m if m < limit else limit
                            elif capture == CAPTURE_ANNOTATION:
                                graph.annotate(owner, handles, 1 + leader_lines)
                        elif capture == CAPTURE_RECORD:
                            graph.record(handles, names)
                        elif capture == CAPTURE_STYLE:
                            graph.style(handles, names)
                line = values[i]
                if line == b"EOF":
                    if pend_p >= 0:
                        add_parent(pend_p)
                        add_child(pend_c)
                        add_mult(pend_m)
                    graph.last_parent = pend_p
                    graph.last_child = pend_c
                    graph.blocks += block_count
                    return pairs
                kind = line.strip()
                capture = 0
                if names:
                    names = []
                if owners:
                    owners = []
                if handles:
                    handles = []
                cols = rows = 1
                leader_lines = 0
                if kind == b"SECTION" or kind == b"ENDSEC":
                    in_entities = in_blocks = in_tables = in_objects = scoped = False
                    naming = kind == b"SECTION"
                    kind = None
                    current = -1
                elif scoped:
                    if kind in REFERENCE_KINDS:
                        capture = CAPTURE_INSERT if kind == b"INSERT" else CAPTURE_REFERENCE
                    elif kind in ANNOTATION_KINDS:
                        capture = CAPTURE_ANNOTATION
                    elif in_blocks and kind == b"BLOCK":
                        capture = CAPTURE_BLOCK
                elif in_tables and kind == b"BLOCK_RECORD":
                    capture = CAPTURE_RECORD
                elif (in_tables or in_objects) and kind in STYLE_KINDS:
                    capture = CAPTURE_STYLE
                    dimstyle = STYLE_KINDS[kind]
                continue
            if c == COMMENT_CODE:
                continue
            line = values[i]
            if naming:
                naming = False
                if c == NAME_CODE:
                    in_entities = line == b"ENTITIES"
                    in_blocks = line == b"BLOCKS"
                    in_tables = line == b"TABLES"
                    in_objects = line == b"OBJECTS"
                    scoped = in_entities or in_blocks
                    continue
            if scoped and 0 < c < type_count:
                t = types[c]
                if t:
                    text = line.strip()
                    if real(text) is None:
                        raise numeric_finding("non_numeric_value", base + 2 * i + 2, c, counters)
                    if t == TYPE_COORDINATE:
                        value = float(text)
                        if not -max_abs <= value <= max_abs:
                            raise numeric_finding("coordinate_out_of_range", base + 2 * i + 2, c, counters)
                    elif t == TYPE_REAL and isinf(float(text)):
                        raise numeric_finding("non_numeric_value", base + 2 * i + 2, c, counters)
            if capture:
                if capture == CAPTURE_ANNOTATION:
                    if c in ANNOTATION_HANDLE_CODES:
                        handles.append(line)
                    elif line.strip() == LEADER_LINE_MARKER:
                        leader_lines += 1
                elif capture == CAPTURE_STYLE:
                    if c in STYLE_HANDLE_CODES:
                        handles.append(line)
                    elif dimstyle and c in STYLE_NAME_CODES:
                        names.append(line)
                elif c == NAME_CODE:
                    names.append(line)
                elif capture == CAPTURE_INSERT:
                    if c == COLUMN_CODE:
                        cols = max(cols, count_value(line))
                    elif c == ROW_CODE:
                        rows = max(rows, count_value(line))
                elif capture == CAPTURE_BLOCK:
                    if c == OWNER_CODE:
                        owners.append(line)
                elif capture == CAPTURE_RECORD and c == HANDLE_CODE:
                    handles.append(line)
    return pairs


def judge_graph(graph, max_inserts, max_entities, max_nesting, counters):
    graph.resolve_references()
    direct = graph.direct
    parents = graph.parents
    children = graph.children
    links = {}

    def find(x):
        top = x
        while top in links:
            top = links[top]
        while x != top:
            up = links[x]
            links[x] = top
            x = up
        return top

    for a, b in graph.unions:
        ra = find(a)
        rb = find(b)
        if ra != rb:
            links[rb] = ra
    for x in list(links):
        top = find(x)
        direct[top] += direct[x]
        direct[x] = 0
    if links:
        canon = {x: find(x) for x in links}
        parents = array("q", map(canon.get, parents, parents))
        children = array("q", map(canon.get, children, children))
    root = find(graph.root)
    sat_inserts = max_inserts + 1
    sat_entities = max_entities + 1
    sat_nesting = max_nesting + 1
    counters["blocks"] = graph.blocks
    counters["entities"] = min(direct[root], sat_entities)
    if any(map(operator.eq, parents, children)):
        raise Finding("too_complex", "cyclic_block_reference", counters)
    n = len(direct)
    internal = set(parents)
    if all(map(operator.le, parents, itertools.islice(parents, 1, None))):
        by_parent = parents
        by_child = children
        by_mult = graph.mults
    else:
        perm = sorted(range(len(parents)), key=parents.__getitem__)
        by_parent = array("q", map(parents.__getitem__, perm))
        by_child = array("q", map(children.__getitem__, perm))
        by_mult = array("q", map(graph.mults.__getitem__, perm))
        del perm
    core = bytes(map(internal.__contains__, by_child))
    if all(core):
        core_parents, core_children, core_mults = by_parent, by_child, by_mult
        leaf_parents = leaf_mults = leaf_direct = array("q")
    else:
        leaf = bytes(map(operator.not_, core))
        core_parents = array("q", itertools.compress(by_parent, core))
        core_children = array("q", itertools.compress(by_child, core))
        core_mults = array("q", itertools.compress(by_mult, core))
        leaf_parents = array("q", itertools.compress(by_parent, leaf))
        leaf_mults = array("q", itertools.compress(by_mult, leaf))
        leaf_direct = array("q", map(direct.__getitem__, itertools.compress(by_child, leaf)))
        del leaf
    del by_parent, by_child, by_mult, core
    leaf_ins = array("q", bytes(8 * n))
    leaf_ent = {}
    has_leaf = bytearray(n)
    pos = 0
    while pos < len(leaf_parents):
        parent = leaf_parents[pos]
        end = bisect.bisect_right(leaf_parents, parent, pos)
        mults = leaf_mults[pos:end]
        leaf_ins[parent] = min(sum(mults), sat_inserts)
        leaf_ent[parent] = sum(map(operator.mul, mults, leaf_direct[pos:end]))
        has_leaf[parent] = 1
        pos = end
    del leaf_parents, leaf_mults, leaf_direct
    start = array("q", bytes(8 * (n + 1)))
    pos = 0
    while pos < len(core_parents):
        parent = core_parents[pos]
        end = bisect.bisect_right(core_parents, parent, pos)
        start[parent] = pos
        start[parent + 1] = end
        pos = end
    del core_parents
    indeg = array("q", bytes(8 * n))
    for c in core_children:
        indeg[c] += 1
    ready = [x for x in internal if not indeg[x]]
    order = []
    while ready:
        x = ready.pop()
        order.append(x)
        for k in range(start[x], start[x + 1]):
            c = core_children[k]
            left = indeg[c] - 1
            indeg[c] = left
            if not left:
                ready.append(c)
    if len(order) != len(internal):
        raise Finding("too_complex", "cyclic_block_reference", counters)
    del indeg, ready
    hop = bytearray(b"\x01") * n
    for x in graph.virtual:
        hop[x] = 0
    depth = array("q", bytes(8 * n))
    inserts = array("q", bytes(8 * n))
    entities = array("q", bytes(8 * n))
    for x in reversed(order):
        d = has_leaf[x]
        ins = leaf_ins[x]
        ent = direct[x] + leaf_ent[x] if d else direct[x]
        for k in range(start[x], start[x + 1]):
            c = core_children[k]
            m = core_mults[k]
            step = hop[c]
            dc = depth[c] + step
            if dc > d:
                d = dc
            ins += m * (step + inserts[c])
            ent += m * entities[c]
        depth[x] = d if d < sat_nesting else sat_nesting
        inserts[x] = ins if ins < sat_inserts else sat_inserts
        entities[x] = ent if ent < sat_entities else sat_entities
    if root not in internal:
        entities[root] = min(direct[root], sat_entities)
    counters["nesting"] = depth[root]
    counters["expanded_inserts"] = inserts[root]
    counters["expanded_entities"] = entities[root]
    if counters["nesting"] > max_nesting:
        raise Finding("too_complex", "nesting_too_deep", counters)
    if counters["expanded_inserts"] > max_inserts:
        raise Finding("too_complex", "expanded_inserts_over_cap", counters)
    if counters["expanded_entities"] > max_entities:
        raise Finding("too_complex", "expanded_entities_over_cap", counters)
    return counters


def scan_dxf(path, max_inserts, max_entities, max_nesting, max_abs):
    counters = {}
    with open(path, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            raise Finding("unreadable", "cannot_count", counters)
        encoding = dxf_encoding(fh)
        fh.seek(0)
        graph = BlockGraph(encoding, max(max_inserts, max_entities) + 1)
        pairs = walk_dxf(fh, graph, max_abs, counters)
    if pairs == 0:
        raise Finding("unreadable", "cannot_count", counters)
    return judge_graph(graph, max_inserts, max_entities, max_nesting, counters)


def emit(verdict, reason, counters):
    obj = {"stage": "guard", "verdict": verdict, "reason": reason}
    obj.update(counters)
    sys.stdout.write("CADVERDICT " + json.dumps(obj, separators=(",", ":"), sort_keys=True) + "\n")
    sys.stdout.flush()


def main():
    ap = Parser(prog="cad-guard", add_help=False)
    ap.add_argument("--format", required=True, choices=("step", "iges", "dxf"))
    ap.add_argument("--max-entities", type=int)
    ap.add_argument("--max-nauo", type=int)
    ap.add_argument("--max-expanded-inserts", type=int)
    ap.add_argument("--max-expanded-entities", type=int)
    ap.add_argument("--max-nesting", type=int)
    ap.add_argument("--max-abs-coordinate", type=float)
    ap.add_argument("src")
    args = ap.parse_args()
    if args.format == "dxf":
        caps = (args.max_expanded_inserts, args.max_expanded_entities, args.max_nesting)
        if None in caps or args.max_abs_coordinate is None:
            ap.error("--format dxf requires --max-expanded-inserts, --max-expanded-entities, --max-nesting and --max-abs-coordinate")
        if not all(0 <= cap < COUNT_LIMIT for cap in caps):
            ap.error("the dxf caps must be non-negative integers below %d" % COUNT_LIMIT)
        if not (math.isfinite(args.max_abs_coordinate) and args.max_abs_coordinate > 0):
            ap.error("--max-abs-coordinate must be a positive finite number")
    elif args.max_entities is None or args.max_nauo is None:
        ap.error("--format %s requires --max-entities and --max-nauo" % args.format)
    try:
        if args.format == "iges":
            counters = scan_iges(args.src)
        elif args.format == "dxf":
            counters = scan_dxf(args.src, args.max_expanded_inserts, args.max_expanded_entities,
                                args.max_nesting, args.max_abs_coordinate)
        else:
            counters = scan_step(args.src, args.max_entities, args.max_nauo)
    except Finding as finding:
        emit(finding.verdict, finding.reason, finding.counters)
        return EXIT_TOO_COMPLEX if finding.verdict == "too_complex" else EXIT_UNREADABLE
    except Exception as exc:
        sys.stderr.write("cad-guard: %s: %s\n" % (exc.__class__.__name__, exc))
        emit("unreadable", "cannot_count", {})
        return EXIT_UNREADABLE
    emit("ok", "", counters)
    return EXIT_OK

if __name__ == "__main__":
    sys.exit(main())
