{
  "capabilities": [
    {
      "id": "octoconv.render.cad",
      "version": 2,
      "legacy": {"operation": "render", "engine": "cad"},
      "client_operation": "render",
      "inputs": [{"role": "source", "min": 1, "max": 1}],
      "outputs": [
        {"role": "primary", "min": 1, "max": 1},
        {"role": "measurements", "min": 0, "max": 1}
      ],
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view": {"type": "string", "enum": ["iso", "front", "back", "left", "right", "top", "bottom"], "default": "iso"},
          "size": {"type": "integer", "minimum": 256, "maximum": 2048, "default": 1280},
          "quality": {"type": "string", "enum": ["draft", "standard", "fine"], "default": "standard"},
          "background": {"type": "string", "enum": ["opaque", "transparent"], "default": "opaque"},
          "assume_unit": {"type": "string", "enum": ["mm", "cm", "m", "inch", "foot", "micrometre"]},
          "dimensions": {"type": "boolean", "default": true},
          "material": {"type": "string", "enum": ["steel", "copper", "aluminum"], "default": "steel"},
          "color": {"type": "string", "enum": ["natural", "blue", "black"], "default": "natural"},
          "finish": {"type": "string", "enum": ["bare", "polished", "anodized", "matte_powder_coat"], "default": "bare"}
        }
      },
      "formats": [
        {"from": "step", "to": "png"},
        {"from": "iges", "to": "png"},
        {"from": "stl", "to": "png"}
      ]
    }
  ]
}
